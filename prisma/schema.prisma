// Схема Prisma — срез 12 (профиль + расчёт нормы).
// Сущности аккаунта (User/Session, тикеты 04/08) + профиль и цели (тикет 12):
// UserProfile (физданные, 1:1) и NutritionProfile (целевые диапазоны КБЖУ).
// Портируемость SQLite -> PostgreSQL: смена provider + DATABASE_URL, схема без изменений.
// Enum'ы полей (sex/activityLevel/goal) хранятся строкой — SQLite не поддерживает
// Prisma enum; допустимые значения фиксируются типами в /core/nutrition. На PostgreSQL
// при желании заменяются на native enum без изменения данных.
// Остальные сущности модели данных (тикет 04) добавляются своими тикетами (13+).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // Согласие на обработку данных при регистрации (тикет 08, приватность).
  consentAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  profile            UserProfile?
  nutritionProfiles  NutritionProfile[]
  favorites          FavoriteRecipe[]
  blocks             BlockedRecipe[]
  recurring          RecurringRecipe[]
  keywordFilters     KeywordFilter[]
  mealSlotSettings   MealSlotSetting[]
  pantryLots         PantryLot[]
}

// Физданные пользователя (1:1 к User). Основа для расчёта нормы (тикеты 04, 12).
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  sex             String // "male" | "female"
  age             Int
  heightCm        Float
  weightKg        Float
  bodyFatPct      Float? // опционально; если задан — белок по сухой массе
  activityLevel   String // "sedentary" | "light" | "moderate" | "high"
  goal            String // "lose" | "maintain" | "gain"
  // День закупки (0–6, Пн–Вс). Задел под список покупок; UI появится в своём тикете.
  shoppingWeekday Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Целевые диапазоны КБЖУ. В MVP ровно один isActive на пользователя;
// схема поддерживает несколько (переключение — позже, тикет 04).
model NutritionProfile {
  id     String @id @default(cuid())
  userId String
  name   String @default("Моя норма")

  kcalMin    Int
  kcalMax    Int
  proteinMin Int
  proteinMax Int
  fatMin     Int
  fatMax     Int
  carbMin    Int
  carbMax    Int
  fiberMin   Int
  // Мягкие максимумы, низкий приоритет (тикет 04). В MVP не заполняются.
  sodiumMax      Int?
  cholesterolMax Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Еда: продукты и рецепты (тикет 13, модель тикета 04) ---
// Теги (аллергены/слоты/диеты/техника) — через join-таблицы, а не scalar-списки:
// SQLite их не поддерживает, а join даёт одинаковую схему на SQLite/PostgreSQL и
// удобные запросы для фильтров. Значения-«enum» (unit, allergen, slot, tag,
// equipment) хранятся строкой — по той же причине, что sex/activityLevel/goal
// выше (SQLite не поддерживает Prisma enum); допустимые значения фиксируются
// union-типами в seed-data.ts / core. КБЖУ рецепта не хранится — считается из
// состава (/core/nutrition/recipe.ts).

// Продукт-ингредиент. Нутриенты — на 100 г/мл (для шт — на 100 г съедобной части).
model Ingredient {
  id            String  @id @default(cuid())
  name          String
  // Группа продукта (двойная роль: категория в UI + ключ для будущего скоринга).
  group         String
  unit          String  // "g" | "ml" | "pcs"
  // КБЖУ + клетчатка на 100 г; натрий в мг на 100 г. Источник — research-таблица
  // (kbju-master.md D1: USDA/Скурихин).
  kcalPer100    Float
  proteinPer100 Float
  fatPer100     Float
  carbPer100    Float
  fiberPer100   Float   @default(0)
  sodiumPer100  Float   @default(0)
  // Магазинная упаковка и цена-ориентир ₽ (цена ненадёжна, тикет 01).
  packSize      Float
  pricePerPack  Float
  shelfLifeDays Int
  // Масса одной штуки, г — только для штучных (unit="pcs"). Список покупок (тикет
  // 18) переводит «граммовый эквивалент рецепта → штуки» продажи через это поле;
  // для г/мл — null (потребность уже в единице продажи).
  gramsPerPiece Float?
  // Кастом-продукт (тикет 04): isCustom + ownerUserId. Базовый — оба пусты.
  isCustom      Boolean @default(false)
  ownerUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allergens         IngredientAllergen[]
  recipeIngredients RecipeIngredient[]

  @@index([group])
  @@index([ownerUserId])
}

model IngredientAllergen {
  id           String @id @default(cuid())
  ingredientId String
  // "milk"|"gluten"|"egg"|"fish"|"meat"|"poultry"|"nuts"|"soy" (см. /core/nutrition).
  allergen     String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, allergen])
  @@index([allergen])
}

// Рецепт. КБЖУ считается из RecipeIngredient, поэтому здесь не хранится.
model Recipe {
  id           String  @id @default(cuid())
  name         String
  // Шаги приготовления — по одному на строку (разделитель \n).
  steps        String
  timeMin      Int
  difficulty   Int     @default(1) // 1–3
  servings     Int     @default(1)
  // Кастом-рецепт и персонализация базового (тикет 04) — задел, UI позже.
  isCustom     Boolean @default(false)
  ownerUserId  String?
  baseRecipeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]
  slots       RecipeSlot[]
  dietTags    RecipeDietTag[]
  equipment   RecipeEquipment[]

  @@index([ownerUserId])
}

model RecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String
  // Масса в граммах на всё блюдо (для мл — миллилитры, плотность ~1; для шт —
  // граммовый эквивалент). КБЖУ считается по этой массе.
  grams        Float

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeSlot {
  id       String @id @default(cuid())
  recipeId String
  slot     String // "breakfast"|"lunch"|"dinner"|"snack"

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, slot])
  @@index([slot])
}

model RecipeDietTag {
  id       String @id @default(cuid())
  recipeId String
  tag      String // "vegetarian"|"vegan"|"pescatarian" (подписи — src/lib/food-labels)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tag])
  @@index([tag])
}

model RecipeEquipment {
  id        String @id @default(cuid())
  recipeId  String
  equipment String // "stove"|"oven"|"blender"|"multicooker"|"none"

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, equipment])
}

// --- Вкусы и предпочтения (тикет 16, модель тикета 04) ---
// Мягкие предпочтения по блюдам: избранное (бонус), блок (жёсткий стоп-лист),
// recurring (often/always) и keyword-фильтры «не хочу есть». Ядро /core/generator
// уже умеет их принимать (Preferences/GeneratorConstraints); здесь — их хранение.
// recipeId ссылается на Recipe без внешнего ключа-каскада к рецепту: базовые
// рецепты общие, а предпочтения привязаны к пользователю (каскад по User).

// Избранный рецепт пользователя (скоринговый бонус).
model FavoriteRecipe {
  id       String @id @default(cuid())
  userId   String
  recipeId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

// Заблокированный рецепт (жёсткий стоп-лист: никогда не попадёт в план).
model BlockedRecipe {
  id       String @id @default(cuid())
  userId   String
  recipeId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

// Recurring-рецепт: often (регулярно, больший бонус) или always (обязательно
// присутствует, освобождён от анти-повторов).
model RecurringRecipe {
  id        String @id @default(cuid())
  userId    String
  recipeId  String
  frequency String // "often" | "always"

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

// Keyword-фильтр «не хочу есть»: один термин на строку. Разворачивание синонимов
// («курица» → грудка/бедро/…) — на слое данных (/core/generator/keywords).
model KeywordFilter {
  id     String @id @default(cuid())
  userId String
  term   String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@index([userId])
}

// Настройка приёма: режим «только recurring» (decision 06: MealType.onlyRecurring).
// Хранится по слоту (breakfast|lunch|dinner|snack) «тонкого» слоя, пока модели
// MealType/DaySetting нет в схеме. Строка есть только для настроенных слотов.
model MealSlotSetting {
  id            String  @id @default(cuid())
  userId        String
  slot          String // "breakfast" | "lunch" | "dinner" | "snack"
  onlyRecurring Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId])
}

// --- Кладовка (тикет 19, модель тикета 04, решение 07) ---
// Запас продуктов дома лотами. Два состояния строго раздельны (поле `kind`):
//  • real    — физически дома сейчас: список покупок вычитает, генератор
//              приоритетно использует (бонус кладовки);
//  • pending — прогноз неподтверждённой покупки: НЕ вычитается (иначе двойной
//              счёт), генератор не считает своим; при подтверждении покупки
//              промотится в real.
// ingredientId ссылается на Ingredient без FK-каскада (как recipeId в
// предпочтениях): базовые продукты общие, а лоты привязаны к пользователю
// (каскад по User). Снапшот покупки (замороженный список) — состояние клиента,
// в «тонком» слое не персистится (как и сам список покупок).
model PantryLot {
  id           String    @id @default(cuid())
  userId       String
  ingredientId String
  // Количество в единице продажи продукта (г/мл/шт), > 0.
  qty          Float
  // "real" | "pending" — строго раздельны (решение 07). По умолчанию real.
  kind         String    @default("real")
  // Срок годности; null — без срока (напр. соль). real-лоты подтверждения =
  // дата покупки + Ingredient.shelfLifeDays.
  expiresAt    DateTime?
  // Источник лота (напр. "purchase") — задел под трекинг/списание (тикет 20).
  source       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, kind])
  @@index([ingredientId])
}

model Session {
  id String @id @default(cuid())
  // В БД хранится только SHA-256 хеш токена; сырой токен живёт в httpOnly-cookie.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
